@page "/ratings/create"
@using Microsoft.EntityFrameworkCore
@using RecipesSharingWebsite.Domain
@inject IDbContextFactory<RecipesSharingWebsite.Data.RecipesSharingWebsiteContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Rating</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Rating" OnValidSubmit="AddRating" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="ratingvalue" class="form-label">RatingValue:</label> 
                <InputNumber id="ratingvalue" @bind-Value="Rating.RatingValue" class="form-control" /> 
                <ValidationMessage For="() => Rating.RatingValue" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="recipeid" class="form-label">RecipeID:</label> 
                <InputNumber id="recipeid" @bind-Value="Rating.RecipeID" class="form-control" /> 
                <ValidationMessage For="() => Rating.RecipeID" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="daterated" class="form-label">DateRated:</label> 
                <InputDate id="daterated" @bind-Value="Rating.DateRated" class="form-control" /> 
                <ValidationMessage For="() => Rating.DateRated" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/ratings">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Rating Rating { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRating()
    {
        using var context = DbFactory.CreateDbContext();
        context.Rating.Add(Rating);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/ratings");
    }
}
