@page "/recipes/details"
@using Microsoft.EntityFrameworkCore
@using RecipesSharingWebsite.Domain
@inject IDbContextFactory<RecipesSharingWebsite.Data.RecipesSharingWebsiteContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Recipe</h2>
    <hr />
    @if (recipe is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@recipe.Title</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@recipe.Description</dd>
            <dt class="col-sm-2">CuisineType</dt>
            <dd class="col-sm-10">@recipe.CuisineType</dd>
            <dt class="col-sm-2">PreparationTime</dt>
            <dd class="col-sm-10">@recipe.PreparationTime</dd>
            <dt class="col-sm-2">DifficultyLevel</dt>
            <dd class="col-sm-10">@recipe.DifficultyLevel</dd>
            <dt class="col-sm-2">AuthorName</dt>
            <dd class="col-sm-10">@recipe.AuthorName</dd>
            <dt class="col-sm-2">CategoryID</dt>
            <dd class="col-sm-10">@recipe.CategoryID</dd>
        </dl>
        <div>
            <a href="@($"/recipes/edit?recipeid={recipe.RecipeID}")">Edit</a> |
            <a href="@($"/recipes")">Back to List</a>
        </div>
    }
</div>

@code {
    private Recipe? recipe;

    [SupplyParameterFromQuery]
    private int RecipeID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        recipe = await context.Recipe.FirstOrDefaultAsync(m => m.RecipeID == RecipeID);

        if (recipe is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
