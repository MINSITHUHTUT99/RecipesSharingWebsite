@page "/ingredients/edit"
@using Microsoft.EntityFrameworkCore
@using RecipesSharingWebsite.Domain
@inject IDbContextFactory<RecipesSharingWebsite.Data.RecipesSharingWebsiteContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Ingredient</h2>
<hr />
@if (Ingredient is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Ingredient" OnValidSubmit="UpdateIngredient" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Ingredient.IngredientID" value="@Ingredient.IngredientID" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Ingredient.Name" class="form-control" />
                    <ValidationMessage For="() => Ingredient.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="quantity" class="form-label">Quantity:</label>
                    <InputText id="quantity" @bind-Value="Ingredient.Quantity" class="form-control" />
                    <ValidationMessage For="() => Ingredient.Quantity" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="recipeid" class="form-label">RecipeID:</label>
                    <InputNumber id="recipeid" @bind-Value="Ingredient.RecipeID" class="form-control" />
                    <ValidationMessage For="() => Ingredient.RecipeID" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/ingredients">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int IngredientID { get; set; }

    [SupplyParameterFromForm]
    private Ingredient? Ingredient { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Ingredient ??= await context.Ingredient.FirstOrDefaultAsync(m => m.IngredientID == IngredientID);

        if (Ingredient is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateIngredient()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Ingredient!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!IngredientExists(Ingredient!.IngredientID))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/ingredients");
    }

    private bool IngredientExists(int ingredientid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Ingredient.Any(e => e.IngredientID == ingredientid);
    }
}
